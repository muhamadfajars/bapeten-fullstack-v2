# Copy privately to .env and never commit secrets
BAPETEN_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET
BAPETEN_DATA_DIR=/srv/bapeten-evaluator-private-data
BAPETEN_MAX_FILE_MB=40
BAPETEN_MAX_DOCUMENTS=120
BAPETEN_ANALYSIS_WORKERS=1
BAPETEN_TESS_LANG=ind+eng
# Comma-separated browser origins for dev (production: same origin behind reverse proxy)
BAPETEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Never set to 1 on exposed servers:
BAPETEN_ALLOW_UNAUTHENTICATED_LOCAL_DEV=0
